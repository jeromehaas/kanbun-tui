CreateBoardScreen {
    align: center middle;
}

CreateBoardScreen #dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows:1fr 3 1fr;
    padding: 0 1;
    width: 60;
    height: 15;
    border: thick $background 80%;
    background: $surface;
}

CreateBoardScreen #input_board_name {
    column-span: 2;
    height: 1fr;
    width: 1fr;
}

CreateBoardScreen #title {
    text-style: bold;
    column-span: 2;
}

CreateBoardScreen Button {
    width: 100%;

}