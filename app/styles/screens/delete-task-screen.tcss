DeleteTaskScreen {
    align: center middle;
    background: $background 60%;
}

DeleteTaskScreen #dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 2;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

 DeleteTaskScreen #question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

DeleteTaskScreen #title {
    text-style: bold;
    column-span: 2;
}

DeleteTaskScreen Button {
    width: 100%;

}