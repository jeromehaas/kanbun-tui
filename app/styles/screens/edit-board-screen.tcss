EditBoardScreen {
    align: center middle;
    background: $background 60%;
}

EditBoardScreen #dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows:1fr 3 1fr;
    padding: 0 1;
    width: 60;
    height: 15;
    border: thick $background 80%;
    background: $surface;
}

EditBoardScreen #input_board_name {
    column-span: 2;
    height: 1fr;
    width: 1fr;
}

EditBoardScreen #title {
    text-style: bold;
    column-span: 2;
}

EditBoardScreen Button {
    width: 100%;

}