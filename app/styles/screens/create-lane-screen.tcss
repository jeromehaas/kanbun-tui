CreateLaneScreen {
    align: center middle;
    background: black 60%;
}

CreateLaneScreen #dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3 1fr;
    padding: 0 1;
    width: 60;
    height: 15;
    border: thick $background 80%;
    background: $surface;
}

CreateLaneScreen #input_lane_name {
    column-span: 2;
    height: 1fr;
    width: 1fr;
}

CreateLaneScreen #title {
    text-style: bold;
    column-span: 2;
}

CreateLaneScreen Button {
    width: 100%;

}